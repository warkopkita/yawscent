# ==============================================================================
# YAWSCENT INDONESIA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production

# Web Service Port & Proxies
WEB_PORT=3000
BACKEND_URL=http://backend:5000

# Backend Service Port
BACKEND_PORT=5000

# Database Configuration (PostgreSQL)
POSTGRES_USER=yawscent_user
POSTGRES_PASSWORD=yawscent_secure_pass_2026
POSTGRES_DB=yawscent_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://yawscent_user:yawscent_secure_pass_2026@postgres:5432/yawscent_db?schema=public

# Redis Configuration (Cache & Atomic Stock Locks)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Midtrans Payment Gateway (Production / Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Biteship Logistics Aggregator
BITESHIP_API_KEY=biteship_test_YOUR_KEY

# Security & Sessions
JWT_SECRET=yawscent_super_secret_jwt_key_2026
